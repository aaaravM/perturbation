  "mapping": {
    "summary": "RA = 0 deg at the LEFT edge, increasing to the RIGHT; Dec = +90 at the TOP row, -90 at the bottom row. Like longitude/latitude on a terrestrial map: correct for a globe seen from OUTSIDE.",
    "uv": "u = RA_deg / 360; v_from_top = (90 - Dec_deg) / 180 (three.js uv.y = 1 - v_from_top = (Dec + 90) / 180)",
    "pixel_centre": "RA = (x + 0.5) * 360 / W, Dec = 90 - (y + 0.5) * 180 / H, x and y 0-based, y from the top",
    "threejs": {
      "geometry": "new THREE.SphereGeometry(r, 128, 64) with default UVs; side: THREE.FrontSide; no mesh rotation",
      "texture": "TextureLoader (flipY = true, the default); colorSpace = THREE.SRGBColorSpace; anisotropy = renderer.capabilities.getMaxAnisotropy(); material MeshBasicMaterial({ map, toneMapped: false })",
      "marker_position": "a = RA in radians, d = Dec in radians: x = -r cos(d) cos(a), y = r sin(d), z = r cos(d) sin(a)",
      "orientation": "north celestial pole at +Y; RA 0 faces -X, RA 90 faces +Z, RA 180 faces +X, RA 270 faces -Z; seen from a camera on +Z, RA increases to the right",
      "rotation": "put markers in the same group as the sphere; group.rotation.y = PI/2 - a0 turns RA a0 to face a camera on +Z"
    },
    "seen_from_outside": "a celestial globe seen from outside is the mirror image of the sky seen from Earth (east is to the right here, to the left on a star chart)"
  },
  "source": {
    "hips": "https://irsa.ipac.caltech.edu/data/hips/SPHEREx/spherex_allsky_cube",
