        0.5,
        0.2
      ],
      "floor_srgb": [
        6,
        7,
        10
      ],
      "formula": "y_c = asinh(gain_c * max(q_c - black_c, 0) / soft) / asinh(white / soft); out = floor + (1 - floor) * clip(luma + saturation * (y - luma), 0, 1)"
    },
    "mono": {
      "black_q": 0.8,
      "soft_q": 1.2,
      "white_q": 300.0,
      "floor_srgb": 6,
      "formula": "y = asinh(max(q - black, 0) / soft) / asinh(white / soft); out = floor + (1 - floor) * y"
    },
