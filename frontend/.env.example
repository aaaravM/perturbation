# Copy to .env.local to connect a local copy of the site to the Planet X Hunter API.
# Without it, the prepared challenge targets still work, but live fields, star lookups and
# quick-look spectra say the backend is not connected.
NEXT_PUBLIC_API_URL=https://planet-x-hunter-api.vercel.app

# Or a backend running on this machine (cd backend && uv run uvicorn index:app --port 8000):
# NEXT_PUBLIC_API_URL=http://localhost:8000
